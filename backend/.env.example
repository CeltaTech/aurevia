PORT=4000

# Supabase (Postgres + RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# La llave pública, la misma que ya lleva el Panel adentro. El motor la usa para una sola cosa:
# comprobar que quien pide cambiar su teléfono o cerrar la sesión en todos los equipos sabe su clave
# actual. Sin ella esas dos puertas quedan cerradas, que es el lado seguro del error.
SUPABASE_ANON_KEY=

# El segundo factor por teléfono. Los dos se leen en cada pedido, así que cambiarlos no obliga a
# reiniciar. Vacíos o mal cargados, se usan los valores de fábrica: 10 minutos y 5 códigos.
MINUTOS_DEL_CODIGO_AL_TELEFONO=
TOPE_CODIGOS_AL_TELEFONO_POR_HORA=
# Cuántos pedidos de clave nueva se le aceptan a un mismo correo en una hora, dentro de una misma
# Prestadora. De fábrica, 5. Pedir la clave nueva no exige sesión, así que sin tope cualquiera le
# llena la casilla de correo a una persona repitiendo el pedido.
TOPE_PEDIDOS_DE_CLAVE_POR_HORA=
# Cuánto dura la puerta que la Prestadora abre cuando alguien la llama porque no puede entrar. De
# fábrica, 30 minutos: el tiempo de una llamada telefónica.
MINUTOS_DEL_CAMBIO_DE_CLAVE_HABILITADO=
# Cuántas horas espera un número recién verificado antes de servir de segundo factor. De fábrica
# cero, o sea sin espera: la decisión de cuánto esperar todavía no está tomada, y hasta que llegue
# nada cambia para nadie. Quien lo confirma por teléfono desde el Panel no espera nunca.
HORAS_DE_ESPERA_DEL_TELEFONO_NUEVO=

# Nodemailer (Gmail SMTP) — el camino de salida de la máquina de desarrollo. En Railway no sirve:
# los puertos de correo están bloqueados y el envío sale por el despachante de acá abajo.
# El servidor y el puerto son opcionales: sin ellos se usa smtp.gmail.com por el 465, que es lo
# que había. Se completan para salir por otra casilla que no sea de Gmail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Por dónde salen los correos (backend/src/utils/email.js) — el despachante habla por el puerto
# 443, que es el único que Railway deja salir. `REMITENTE_AVISOS` es la dirección común del
# producto, y de ella sale también el dominio bajo el que cuelga la dirección propia de cada
# Prestadora: no hay una variable aparte para el dominio, porque dos variables que tienen que
# coincidir terminan no coincidiendo. Sin estas dos, el motor cae al camino SMTP de arriba.
RESEND_API_KEY=
REMITENTE_AVISOS=

# Cuánto correo acepta el plan contratado del despachante. Son el límite del plan, no una decisión
# del producto, y por eso viven acá: el día que se cambie de plan no hay que tocar una línea de
# código. Con ellas cargadas, el Panel muestra cuánto va del día y del mes contra el límite; sin
# ellas muestra la cuenta y ningún límite, que es preferible a inventar uno y hacer creer que
# queda margen. El plan gratuito de hoy son 100 por día y 3.000 por mes.
TOPE_CORREOS_DIARIO=
TOPE_CORREOS_MENSUAL=

# El camino de vuelta (backend/src/utils/reenvioDeRespuestas.js) — la dirección desde la que manda
# cada Prestadora sólo manda, así que lo que entre ahí se reenvía a la casilla que ella declaró.
# Lo hace Cloudflare Email Routing sobre el mismo dominio. El token es propio de esto y lleva
# permiso de Email Routing: NO es el que publica las pantallas, que está acotado a Pages y DNS y
# vive en los secretos de GitHub. Sin las tres, el motor no intenta abrir ningún reenvío, la
# Prestadora se da de alta igual y las respuestas se pierden, cosa que se avisa en el Panel.
CLOUDFLARE_EMAIL_ROUTING_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Se completa solo para apuntar a otro servidor (pruebas). Vacío es el de verdad.
CLOUDFLARE_API_BASE=

# Activación de cuenta (pendiente #75) — URL pública de cada PWA, usada para armar el link
# de "primera contraseña" que se manda por email a Familia/Asistente/Círculo de cuidado.
PWA_FAMILIAS_URL=
PWA_ASISTENTES_URL=

# Entrevista de reclutamiento — URL pública del Panel, usada para armar el enlace que se le manda
# por correo a quien se postuló. Ahí vive la pantalla donde entra a la videollamada: el postulante
# todavía no es Asistente, así que no tiene ninguna aplicación instalada ni ninguna cuenta.
PANEL_URL=

# Backup (backend/scripts/backup_a_buckets.mjs) — conexión directa a Postgres para pg_dump
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Backup — Cloudflare R2 (bucket principal)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backup — Backblaze B2 (bucket espejo/secundario)
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Web Push (notificaciones push a Asistentes — generar con `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# QR de cobro en efectivo — marketplace (generar con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
QR_COBRO_SECRET=

# Secreto con el que se firman los avisos de cobro de los rieles que NO publican esquema de
# firma: Modo, el PSP que tramita el DEBIN y las redes de cobranza extrabancaria. Los tres
# avisan a una dirección pública, así que lo único que separa un aviso de verdad de uno
# inventado es la firma. Ver `backend/src/pasarelas/firmaWebhook.js`,
# `comprobarFirmaSinEsquemaPublicado`, donde está escrito qué se firma y por qué no se
# reproduce acá ningún esquema de esos proveedores.
#
# **Dejarlos vacíos es una posición válida y es la de fábrica:** sin secreto, esos tres rieles
# rechazan TODO aviso de cobro. Es lo correcto mientras no se haya confirmado con el proveedor
# cómo firma de verdad — prefiero que no entre ninguno a que entre cualquiera.
#
# Lo primero que se mira es el secreto que cada Prestadora carga desde el Panel, que es el que
# ata la firma a esa Prestadora. Estos tres son el de todo el ambiente y se usan solamente
# cuando esa Prestadora no cargó el suyo. Generar con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
MODO_SECRETO_FIRMA_WEBHOOK=
DEBIN_SECRETO_FIRMA_WEBHOOK=
COBRANZA_EFECTIVO_SECRETO_FIRMA_WEBHOOK=

# Clave de la API de Anthropic — la usan las cinco funciones de IA del motor (alertas, WhatsApp,
# importación, reporte y verificación de precios). Sin ella esas funciones quedan apagadas y el
# resto del motor arranca igual. Se saca de la consola de Anthropic; nunca se escribe en el código
# ni se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo de IA (backend/src/config/modeloIA.js) — el nombre del modelo con el que habla el motor.
# Se deja vacío salvo que se quiera probar otro: vacío significa "el que está en el código". No
# elige proveedor, que es siempre Anthropic. Al apuntar a un modelo distinto hay que cargarle el
# precio en `precios_ia_modelo`, o el costo de esas llamadas deja de registrarse.
MODELO_IA=

# Tope de pedidos por minuto (backend/src/middleware/topeDePedidos.js) — cuántos pedidos por
# minuto tolera una misma persona en las rutas que piden o prueban códigos de un solo uso: la
# firma de la instrucción del titular y el pase de guardia. Es una defensa contra la fuerza bruta,
# no una diferencia entre Prestadoras, y por eso vive acá y no en la base: ninguna Prestadora
# tiene que poder subirse su propio techo. Vacío significa "el valor de fábrica" (10). Un número
# muy bajo molesta a quien se equivoca de dígito y vuelve a intentar; uno muy alto no frena nada.
TOPE_PEDIDOS_POR_MINUTO=

# Geocodificación de Argentina (backend/src/geocodificacion/georefAr.js) — API Georef del
# Estado argentino. Es gratuita y abierta: NO lleva clave, y dejando esto vacío el motor usa
# la dirección oficial. Se completa solo para apuntar a otro servidor (pruebas).
GEOREF_API_BASE=

# Siembra de la Prestadora de demostración (backend/scripts/seed_prestadora_demo_poblacion.js) —
# la contraseña con la que nacen las cuentas de esa demo. Estuvo escrita adentro del script, y eso
# dejaba treinta y ocho cuentas de la nube con una clave que cualquiera que abriera el repositorio
# podía leer. Sin esta variable el script no arranca. Sólo hace falta el día que se vuelve a
# sembrar la demo.
SEED_DEMO_PASSWORD=

# Cuentas de prueba de los guiones puntuales de `backend/scripts/` — la contraseña con la que
# nacen las cuentas que esos guiones crean y borran al terminar. La usan
# test_item_b_scope_superadmin.js, test_sesion_soporte_prestadoras.js, test_item_h_mfa.mjs,
# test_pendiente_36.mjs, test_pendiente_73_escanear_asistente.mjs, test_etapa2_sesion_soporte.mjs
# y seed_test_cierre_servicio.js. Estuvo escrita adentro de cada uno, y una cuenta que quedó sin
# borrar por un corte se queda con una clave que cualquiera lee en el repositorio. Sin esta
# variable ninguno arranca.
SEED_TEST_PASSWORD=

# La contraseña de las cuentas de la base local NO se pone acá: no la lee el motor, la lee
# `scripts/poner_la_clave_de_la_siembra.mjs`, que se corre a mano después de cada
# `supabase db reset`. Se llama SEED_LOCAL_PASSWORD y está explicada en `panel/README.md`.
