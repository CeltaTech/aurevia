PORT=4000

# Supabase (Postgres + RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nodemailer (Gmail SMTP)
SMTP_USER=
SMTP_PASSWORD=

# Activación de cuenta (pendiente #75) — URL pública de cada PWA, usada para armar el link
# de "primera contraseña" que se manda por email a Familia/Asistente/Círculo de cuidado.
PWA_FAMILIAS_URL=
PWA_ASISTENTES_URL=

# Backup (backend/scripts/backup_a_buckets.mjs) — conexión directa a Postgres para pg_dump
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Backup — Cloudflare R2 (bucket principal)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backup — Backblaze B2 (bucket espejo/secundario)
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Web Push (notificaciones push a Asistentes — generar con `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# QR de cobro en efectivo — marketplace (generar con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
QR_COBRO_SECRET=

# Clave de la API de Anthropic — la usan las cinco funciones de IA del motor (alertas, WhatsApp,
# importación, reporte y verificación de precios). Sin ella esas funciones quedan apagadas y el
# resto del motor arranca igual. Se saca de la consola de Anthropic; nunca se escribe en el código
# ni se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo de IA (backend/src/config/modeloIA.js) — el nombre del modelo con el que habla el motor.
# Se deja vacío salvo que se quiera probar otro: vacío significa "el que está en el código". No
# elige proveedor, que es siempre Anthropic. Al apuntar a un modelo distinto hay que cargarle el
# precio en `precios_ia_modelo`, o el costo de esas llamadas deja de registrarse.
MODELO_IA=

# Geocodificación de Argentina (backend/src/geocodificacion/georefAr.js) — API Georef del
# Estado argentino. Es gratuita y abierta: NO lleva clave, y dejando esto vacío el motor usa
# la dirección oficial. Se completa solo para apuntar a otro servidor (pruebas).
GEOREF_API_BASE=
